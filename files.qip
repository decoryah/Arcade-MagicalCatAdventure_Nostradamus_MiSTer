set_global_assignment -name SYSTEMVERILOG_FILE MCatAdv.sv
set_global_assignment -name SDC_FILE MCatAdv.sdc
set_global_assignment -name QIP_FILE rtl/pll.qip

# the machine
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mcatadv_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mcatadv_cen.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mcatadv_cache.sv
