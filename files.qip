set_global_assignment -name SYSTEMVERILOG_FILE rtl/mcatadv_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mcatadv_tmap.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mcatadv_sprbuf.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mcatadv_spr.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mcatadv_pcmrd.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mcatadv_zcache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mcatadv_sound.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mcatadv_ovl.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mcatadv_core.sv

# fx68k 68000 (GPL-3, Jorge Cwik); microrom.mem / nanorom.mem are read from the project directory
set_global_assignment -name SYSTEMVERILOG_FILE modules/cpu-fx68k/fx68kAlu.sv
set_global_assignment -name SYSTEMVERILOG_FILE modules/cpu-fx68k/uaddrPla.sv
set_global_assignment -name SYSTEMVERILOG_FILE modules/cpu-fx68k/fx68k.sv
# tv80 Z80 (MIT, Guy Hutchison)
set_global_assignment -name VERILOG_FILE modules/cpu-tv80/tv80_alu.v
set_global_assignment -name VERILOG_FILE modules/cpu-tv80/tv80_core.v
set_global_assignment -name VERILOG_FILE modules/cpu-tv80/tv80_mcode.v
set_global_assignment -name VERILOG_FILE modules/cpu-tv80/tv80_reg.v
set_global_assignment -name VERILOG_FILE modules/cpu-tv80/tv80s_cen.v

# MiSTer platform layer
set_global_assignment -name SYSTEMVERILOG_FILE target/mister/mcatadv_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE target/mister/sdram_ctrl.sv

# jt10 (jt12), YM2610 (GPL-3, Jose Tejada; modules/jt10/UPSTREAM.txt)
